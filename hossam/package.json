{
  "name": "slidev-theme-hossam",
  "version": "1.0.0",
  "private": true,
  "description": "코딩 강의용 흰 바탕 Slidev 테마. sidebar: true/false(왼쪽 목차 사이드바). 콜아웃·프롬프트·출력·단계·격자 컴포넌트.",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "slidev": {
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 1280,
      "fonts": {
        "sans": "Pretendard Variable",
        "mono": "JetBrains Mono",
        "local": "Pretendard Variable, Pretendard"
      },
      "transition": "slide-left",
      "lineNumbers": true
    },
    "colorSchema": "both",
    "highlighter": "shiki"
  }
}
